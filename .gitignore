# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Virtual envs
.venv/
venv/
env/

# Checkpoints / large binaries (commit only explicitly-selected ones)
*.pt
*.pth
*.ckpt
*.onnx

# Datasets — never commit raw media, full datasets, or dataset manifests.
# (The raw CREMA-D / UTD-MHAD media and the manifests hold local absolute
#  paths and are large; regenerate manifests via data/*_manifest.py.)
data/raw/
data/cache/
CREMA-D-full/
UTD-MHAD/
**/raw/
*.wav
*.mp3
*.flv
*.mp4
*.avi
*.npz

# Dataset manifests (contain local absolute media paths)
cremad_manifest.csv
utd_manifest.csv
**/cremad_manifest.csv
**/utd_manifest.csv

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / web build (website has its own .gitignore too)
node_modules/
dist/

# Local paper exports (keep research_paper/main.pdf as the canonical compiled paper)
dl_Ankita*.pdf
research_paper/dl_Ankita*.pdf

# Keep results small: ignore the heavy raw per-run dumps but KEEP figures/tables/processed CSVs.
# (comment the next line out if you want full raw provenance in git)
# results/raw/

# CREMA-D derived feature cache (large; regenerate via experiments/cremad_extract.py)
data/cremad/cache/
*.npy

# UTD-MHAD encoder-input cache + any raw media (regenerate via experiments/utd_extract.py)
data/utd_mhad/cache/
data/utd_mhad/raw/

# UTD-MHAD manifest holds absolute local media paths (regenerate via experiments/utd_audit.py)
results/utd_mhad/utd_manifest.csv

# LaTeX build artifacts (regenerated by pdflatex/bibtex; keep only .tex/.bib/figures/.pdf)
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
