# Datasets: raw media, full datasets and per-machine manifests are never committed.
# CREMA-D and UTD-MHAD live next to the repository (see README); manifests hold
# absolute local paths and are regenerated by data/*_manifest.py.
data/raw/
data/cache/
data/cremad/cache/
data/utd_mhad/cache/
data/utd_mhad/raw/
CREMA-D*/
UTD-MHAD/
